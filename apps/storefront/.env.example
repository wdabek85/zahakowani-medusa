# Storefront (Next.js 15) — przykładowe zmienne środowiskowe.
# Skopiuj do `.env.local` (NIE commitować) i uzupełnij prawdziwe wartości.

# Backend Medusy (port 9000 — z docker-compose backendu)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key — pobierz z admin panelu Medusy
# (http://localhost:9000/app → Settings → API Keys → Publishable)
# albo z `docs/raports/RAPORT-FAZA-1.md` § "Dane logowania"
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_c1af8bc88b01b77c342f35f62974d63d97c4ef7eb064927ba0d3fb1098947c93

# Default region — used przy fetchowaniu cen w PLN
NEXT_PUBLIC_DEFAULT_REGION_CODE=pl
