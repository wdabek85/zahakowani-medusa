# =============================================================
# Zahakowani — przykładowe zmienne środowiskowe
# Skopiuj ten plik do .env (root) oraz apps/medusa/.env
# .env jest w .gitignore — NIGDY nie commituj prawdziwych sekretów
# =============================================================

# ---- Postgres (docker-compose) ----
POSTGRES_USER=zahakowani
POSTGRES_PASSWORD=zahakowani_dev
POSTGRES_DB=zahakowani

# ---- Medusa backend (apps/medusa) ----
DATABASE_URL=postgres://zahakowani:zahakowani_dev@localhost:5432/zahakowani
REDIS_URL=redis://localhost:6379

# ---- Sekrety (na produkcji wygeneruj losowe, długie wartości) ----
# np. openssl rand -hex 32
JWT_SECRET=change_me_in_production_use_long_random_string
COOKIE_SECRET=change_me_in_production_use_long_random_string

# ---- CORS ----
# Frontend storefront (Next.js) — port 8000
STORE_CORS=http://localhost:8000
# Panel admina Medusy — wbudowany pod /app na backendzie
ADMIN_CORS=http://localhost:9000,http://localhost:7001
# Auth dozwolony z obu
AUTH_CORS=http://localhost:9000,http://localhost:7001,http://localhost:8000

# ---- URLe ----
MEDUSA_BACKEND_URL=http://localhost:9000

# ---- Środowisko ----
NODE_ENV=development
